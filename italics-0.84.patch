+            if (GetOutlineTextMetricsA(hdc, i, regularOtm)) {
+                /* Now get the italic version */
+                SelectObject(hdc, wgs->fonts[FONT_ITALIC]);
+                i = GetOutlineTextMetricsA(hdc, 0, NULL);
+                if (i > 0) {
+                    italicOtm = (LPOUTLINETEXTMETRICA)safemalloc(1, i, 0);
